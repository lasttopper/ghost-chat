rules_version = '2';

// Ghost Chat keeps ALL application data on its own backend (the Render
// server), not in Firebase. Firebase is used for Authentication only.
//
// These rules are intentionally default-DENY: if Cloud Firestore is ever
// enabled on this project, nothing is readable or writable until rules are
// added here on purpose. That is the safe starting posture.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
